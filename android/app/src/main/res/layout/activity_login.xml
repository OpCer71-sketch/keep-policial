<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:id="@+id/tvDestacamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Keep Policial"
            android:textColor="@color/primaria"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEndereco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Acesso restrito"
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />

        <LinearLayout style="@style/Secao" android:layout_marginTop="24dp">

            <TextView style="@style/Rotulo" android:layout_marginTop="0dp" android:text="Usuário" />
            <AutoCompleteTextView
                android:id="@+id/etAcesso"
                style="@style/Campo"
                android:completionThreshold="1"
                android:hint="sd.silva@endereço-do-servidor"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textEmailAddress"
                android:maxLength="160" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Digite como um e-mail: seu login, @ e o endereço do servidor, ambos fornecidos pelo comandante."
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />

            <TextView style="@style/Rotulo" android:text="Senha" />
            <EditText
                android:id="@+id/etSenha"
                style="@style/Campo"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <CheckBox
                android:id="@+id/cbTermo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Li e aceito o Termo de Compromisso de Manutenção de Sigilo"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvLerTermo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:padding="6dp"
                android:text="Ler o termo"
                android:textColor="@color/primaria"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_botao_novo"
                android:enabled="false"
                android:text="Entrar"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvServidores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:text="Servidores salvos"
            android:textColor="@color/primaria" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Uso restrito e interno da corporação. Todos os acessos são registrados."
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
