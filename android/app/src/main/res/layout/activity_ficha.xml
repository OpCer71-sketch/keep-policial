<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rolagem"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Fotos -->
        <LinearLayout style="@style/Secao" android:layout_marginTop="0dp">
            <TextView
                android:id="@+id/tvFotosTitulo"
                style="@style/Rotulo"
                android:layout_marginTop="0dp"
                android:text="Fotos (0/10)" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Toque para ampliar. Toque e segure para remover."
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/llFotos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Qualificacao -->
        <LinearLayout style="@style/Secao">
            <TextView style="@style/Rotulo" android:layout_marginTop="0dp" android:text="Nome completo" />
            <EditText
                android:id="@+id/etNome"
                style="@style/Campo"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="150" />

            <TextView style="@style/Rotulo" android:text="Alcunha (vulgo)" />
            <EditText
                android:id="@+id/etAlcunha"
                style="@style/Campo"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLength="100" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Rotulo" android:text="CPF" />
                    <EditText
                        android:id="@+id/etCpf"
                        style="@style/Campo"
                        android:digits="0123456789.-"
                        android:hint="000.000.000-00"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="14" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Rotulo" android:text="RG" />
                    <EditText
                        android:id="@+id/etRg"
                        style="@style/Campo"
                        android:hint="MG-00.000.000"
                        android:importantForAutofill="no"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:maxLength="20" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/Rotulo" android:text="Endereço" />
            <EditText
                android:id="@+id/etEndereco"
                style="@style/Campo"
                android:hint="Rua, número, bairro, cidade, referência"
                android:importantForAutofill="no"
                android:inputType="textPostalAddress|textMultiLine|textCapSentences"
                android:maxLength="300" />
        </LinearLayout>

        <!-- Filiacao -->
        <LinearLayout style="@style/Secao">
            <TextView
                style="@style/Rotulo"
                android:layout_marginTop="0dp"
                android:text="FILIAÇÃO"
                android:textSize="14sp" />
            <TextView style="@style/Rotulo" android:text="Pai" />
            <EditText
                android:id="@+id/etPai"
                style="@style/Campo"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="150" />
            <TextView style="@style/Rotulo" android:text="Mãe" />
            <EditText
                android:id="@+id/etMae"
                style="@style/Campo"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="150" />
        </LinearLayout>

        <!-- Comportamento -->
        <LinearLayout style="@style/Secao">
            <TextView
                style="@style/Rotulo"
                android:layout_marginTop="0dp"
                android:text="COMPORTAMENTO NA ABORDAGEM"
                android:textSize="14sp" />
            <RadioGroup
                android:id="@+id/rgComportamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <RadioButton
                    android:id="@+id/rbObediente"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Obediente"
                    android:textColor="@color/obediente"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <RadioButton
                    android:id="@+id/rbPassivo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Resistente passivo"
                    android:textColor="@color/resistente_passivo"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <RadioButton
                    android:id="@+id/rbAtivo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Resistente ativo"
                    android:textColor="@color/resistente_ativo"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </RadioGroup>
            <TextView
                android:id="@+id/tvLimparComportamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="Limpar seleção"
                android:textColor="@color/texto_suave"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Passagens -->
        <LinearLayout style="@style/Secao">
            <TextView
                style="@style/Rotulo"
                android:layout_marginTop="0dp"
                android:text="PASSAGENS PELA POLÍCIA"
                android:textSize="14sp" />
            <LinearLayout
                android:id="@+id/llPassagens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <Button
                android:id="@+id/btnAddPassagem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="+ Adicionar passagem" />
        </LinearLayout>

        <!-- Veiculos -->
        <LinearLayout style="@style/Secao">
            <TextView
                style="@style/Rotulo"
                android:layout_marginTop="0dp"
                android:text="VEÍCULOS"
                android:textSize="14sp" />
            <LinearLayout
                android:id="@+id/llVeiculos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <Button
                android:id="@+id/btnAddVeiculo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="+ Adicionar veículo" />
        </LinearLayout>

        <!-- Observacoes -->
        <LinearLayout style="@style/Secao">
            <TextView
                style="@style/Rotulo"
                android:layout_marginTop="0dp"
                android:text="OBSERVAÇÕES"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/etObservacoes"
                style="@style/Campo"
                android:gravity="top"
                android:hint="Características físicas, tatuagens, associados, locais frequentados..."
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="200"
                android:minLines="3" />
            <TextView
                android:id="@+id/tvContObs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0/200"
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_botao_novo"
            android:text="Salvar ficha"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvRodape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
