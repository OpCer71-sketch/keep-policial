<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Claro por padrão; values-night/themes.xml troca o pai para o tema escuro. -->
    <style name="TemaBase" parent="android:Theme.Material.Light.DarkActionBar" />

    <style name="Tema" parent="TemaBase">
        <item name="android:colorPrimary">@color/primaria</item>
        <item name="android:colorPrimaryDark">@color/primaria_escura</item>
        <item name="android:colorAccent">@color/destaque</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/texto_suave</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/primaria_escura</item>
        <item name="android:navigationBarColor">@color/primaria_escura</item>
    </style>

    <style name="Rotulo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/destaque</item>
    </style>

    <!-- Campos grandes: facilitam o toque com luva, em movimento ou sob estresse. -->
    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/texto_suave</item>
    </style>

    <style name="Secao">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/bg_cartao</item>
    </style>

    <!-- Botão principal: verde oliva, 60 dp de altura. -->
    <style name="BotaoTatico">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:background">@drawable/bg_botao_novo</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Botão secundário: contorno coyote, também 56 dp. -->
    <style name="BotaoSecundario">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:background">@drawable/bg_botao_sec</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>
</resources>
