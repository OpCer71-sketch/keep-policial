<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Saber se ha conexao (modo offline e sincronizacao automatica). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Atualizacao do app baixada do GitHub: pede ao Android para instalar o APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Tema"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ListaActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden" />

        <activity
            android:name=".FichaActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".HistoricoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <provider
            android:name=".CameraProvider"
            android:authorities="com.keeppolicial.app.camera"
            android:exported="false"
            android:grantUriPermissions="true" />

        <provider
            android:name=".ApkProvider"
            android:authorities="com.keeppolicial.app.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
